diff --git a/src/main/blackbox/blackbox_virtual.c b/src/main/blackbox/blackbox_virtual.c
index 3ec6d7778..ba2d7cf9f 100644
--- a/src/main/blackbox/blackbox_virtual.c
+++ b/src/main/blackbox/blackbox_virtual.c
@@ -28,16 +28,23 @@
 #include <dirent.h>
 #include <common/maths.h>
 
+#include "blackbox_virtual.h"
+
 #define LOGFILE_PREFIX "LOG"
 #define LOGFILE_SUFFIX "BFL"
 #define NAME_BUFFER_LENGTH 13   //file name template: LOG00001.BFL, 13 = 12 symbols + \0
 
 static FILE *blackboxVirtualFile = NULL;
 static int32_t largestLogFileNumber = 0;
+char blackboxVirtualDir[512] = ".";
 
 bool blackboxVirtualOpen(void)
 {
-    DIR *dir = opendir(".");
+    // libfpv: a log left open (the drone went away armed, the simulator
+    // rebooted in-process) is complete up to there: close it, start anew
+    blackboxVirtualEndLog();
+    largestLogFileNumber = 0;
+    DIR *dir = opendir(blackboxVirtualDir);
     if (!dir) {
         return false; // Failed to open directory
     }
@@ -75,7 +82,12 @@ void blackboxVirtualWrite(const uint8_t *buffer, uint32_t len)
 bool blackboxVirtualFlush(void)
 {
     if (blackboxVirtualFile != NULL) {
-        fflush(blackboxVirtualFile);
+        // libfpv: called every loop; a flush about every 0.1 s keeps the
+        // file readable after a crash without a write per loop
+        static uint32_t calls;
+        if ((++calls & 0x3FF) == 0) {
+            fflush(blackboxVirtualFile);
+        }
         return true;
     } else {
         return false;
@@ -89,7 +101,9 @@ bool blackboxVirtualBeginLog(void)
     }
     char filename[NAME_BUFFER_LENGTH];
     snprintf(filename, NAME_BUFFER_LENGTH, "%s%05u.%s", LOGFILE_PREFIX, (largestLogFileNumber + 1) % 100000, LOGFILE_SUFFIX);
-    blackboxVirtualFile = fopen(filename, "w");
+    char path[sizeof(blackboxVirtualDir) + NAME_BUFFER_LENGTH + 1];
+    snprintf(path, sizeof(path), "%s/%s", blackboxVirtualDir, filename);
+    blackboxVirtualFile = fopen(path, "wb");  // binary: Windows text mode would add a CR before each LF
     if (blackboxVirtualFile != NULL) {
         largestLogFileNumber++;
     }
diff --git a/src/main/blackbox/blackbox_virtual.h b/src/main/blackbox/blackbox_virtual.h
index ebf878e9c..5d956631b 100644
--- a/src/main/blackbox/blackbox_virtual.h
+++ b/src/main/blackbox/blackbox_virtual.h
@@ -25,6 +25,9 @@
 #error "USE_BLACKBOX_VIRTUAL valid for SITL build only"
 #endif
 
+// libfpv: the folder the logs go to (default: the working directory)
+extern char blackboxVirtualDir[512];
+
 bool blackboxVirtualOpen(void);
 void blackboxVirtualPutChar(uint8_t value);
 void blackboxVirtualWrite(const uint8_t *buffer, uint32_t len);
--- a/src/main/osd/osd.c
+++ b/src/main/osd/osd.c
@@ -778,9 +778,11 @@ static void osdGetBlackboxStatusString(char * buff)
         break;
     }
 
-    if (storageDeviceIsWorking) {
+    if (storageDeviceIsWorking && storageTotal) {
         const uint16_t storageUsedPercent = (storageUsed * 100) / storageTotal;
         tfp_sprintf(buff, "%d%%", storageUsedPercent);
+    } else if (storageDeviceIsWorking) {
+        tfp_sprintf(buff, "OK");  // libfpv: VIRTUAL (log files) has no fixed size
     } else {
         tfp_sprintf(buff, "FAULT");
     }
