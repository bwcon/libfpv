+// A simulator moved the craft (a teleport): restart the filters at rest,
+// at an unknown position. The baro and GPS still report the old place for
+// a while, so measurements wait until they caught up; then the first one
+// places the filters without disturbing the velocity. The arming
+// references (sensor offsets, origin) are kept.
+#define RESEED_POS_VAR      1e10f    // cm^2
+#define RESEED_SETTLE_US    200000   // > GPS period plus baro latency
+void positionEstimatorReseed(void)
+{
+    kalmanInit(&kfUp, kalmanGetPosition(&kfUp), 0.0f, RESEED_POS_VAR, INITIAL_VEL_VAR, Q_ACCEL_Z);
+    kalmanInit(&kfEast, kalmanGetPosition(&kfEast), 0.0f, RESEED_POS_VAR, INITIAL_VEL_VAR, qaccelXY);
+    kalmanInit(&kfNorth, kalmanGetPosition(&kfNorth), 0.0f, RESEED_POS_VAR, INITIAL_VEL_VAR, qaccelXY);
+    reseedUntilUs = micros() + RESEED_SETTLE_US;
+}
