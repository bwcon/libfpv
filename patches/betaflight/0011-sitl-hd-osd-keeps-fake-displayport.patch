diff --git a/src/main/fc/init.c b/src/main/fc/init.c
index 4396ab1a0..e88ba6d47 100644
--- a/src/main/fc/init.c
+++ b/src/main/fc/init.c
@@ -944,11 +944,17 @@ void initPhase3(void)
     if (featureIsEnabled(FEATURE_OSD)) {
         osdDisplayPortDevice_e device;
 
+#if defined(SIMULATOR_BUILD)
+        // The simulator's in-memory display (SimITL displayport_fake) also
+        // serves the HD canvas: MSP would send the OSD out over a serial port.
+        device = OSD_DISPLAYPORT_DEVICE_AUTO;
+#else
         if (vcdProfile()->video_system == VIDEO_SYSTEM_HD) {
             device = OSD_DISPLAYPORT_DEVICE_MSP;
         } else {
             device = osdConfig()->displayPortDevice;
         }
+#endif
 
         switch(device) {
 
