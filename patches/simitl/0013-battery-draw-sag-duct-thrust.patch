+  // libfpv: a duct adds thrust through the suction on its lip, which only
+  // exists while the prop pulls in slow air around it. It is gone by about
+  // half the zero-thrust inflow; past that the bare prop's curve applies.
+  constexpr float DUCT_FADE_ZERO_THRUST_RATIO = 0.5f;
 
+  static float ductThrustFactor(float gain, float pitch, float rpm, float vel) {
+    if (gain <= 0.0f || pitch <= 0.0f) return 1.0f;
+    if (vel <= 0.0f) return 1.0f + gain;
+    const float fadeVel = DUCT_FADE_ZERO_THRUST_RATIO * ZERO_THRUST_PITCH_RATIO * pitch * std::max(rpm, 0.0f) / 60.0f;
+    if (fadeVel <= 0.01f) return 1.0f;
+    return 1.0f + gain * std::max(0.0f, 1.0f - vel / fadeVel);
+  }
