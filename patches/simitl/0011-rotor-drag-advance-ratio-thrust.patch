+  // libfpv: share of static thrust left at an axial inflow of `vel` m/s
+  // (climbing, positive). Measured small-prop thrust coefficients follow
+  // CT(J) ~ CT0 * (1 - (J / J0)^2), with zero thrust (J0) at about 0.9 of the
+  // geometric pitch speed. Descending (vel < 0) keeps static thrust.
+  constexpr float ZERO_THRUST_PITCH_RATIO = 0.9f;
+
+  static float inflowThrustFactor(float pitch, float rpm, float vel) {
+    if (vel <= 0.0f) return 1.0f;
+    const float zeroThrustVel = ZERO_THRUST_PITCH_RATIO * pitch * std::max(rpm, 0.0f) / 60.0f;
+    if (zeroThrustVel <= 0.01f) return 0.0f;
+    const float j = vel / zeroThrustVel;
+    return std::max(0.0f, 1.0f - j * j);
+  }
+
+  // Shaft power drops less than thrust as the prop unloads: at zero thrust a
+  // small prop still needs about a quarter of its static torque.
+  static float inflowTorqueFactor(float pitch, float rpm, float vel) {
+    return 0.25f + 0.75f * inflowThrustFactor(pitch, rpm, vel);
   }
 
